# Fins de ligne normalisees pour un fonctionnement identique Windows / Linux
* text=auto

# Scripts shell : toujours LF (sinon le shebang casse sous Linux)
*.sh   text eol=lf

# Scripts Windows : toujours CRLF
*.bat  text eol=crlf

# Code : LF
*.py   text eol=lf
*.html text eol=lf
*.md   text eol=lf
